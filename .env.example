# Copier ce fichier en .env puis adapter les valeurs.
# Le vrai .env ne doit JAMAIS être commité (il est dans le .gitignore).

# Base PostgreSQL
POSTGRES_USER=dropzone
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=dropzone

# API
LOG_LEVEL=INFO
SEED_DEMO_DATA=true

# Version publiée à lancer avec compose.release.yml (sans le "v")
VERSION=0.2.0